# The app's settings on the web host: copy to <app dir>/.env there, mode 600, and fill in every line.
# deploy.sh passes this file to docker compose, and the deploy scripts read it (never as shell).

# Secrets: two long random strings, e.g. `openssl rand -hex 32` each. Put the same INGEST_TOKEN in the lab's
# lab/settings.yaml on the GPU host.
INGEST_TOKEN=
WEBUI_SECRET_KEY=

# Public hostnames, routed by Cloudflare's tunnel to the edge Caddy. The chat one must be behind Cloudflare Access.
SITE_HOST=localinference.example.com
CHAT_HOST=chat.example.com

# The GPU host's tailnet name and address: the chat and the homepage's status probe reach the hosted model at
# https://$AI_HOST:8443 (tailscale serve there). The address is pinned so the web host needs no tailnet DNS.
AI_HOST=ai.example-tailnet.ts.net
AI_IP=100.64.0.1

# Where the site's database (and its backups) and Open WebUI's data live, owned by the deploying user (uid 1000).
LLMLAB_DATA_DIR=/opt/llmlab-data

# The shared edge Caddy: its Caddyfile (a single-file bind mount, edited in place), its container, and the other
# sites it serves (comma-separated; apply-caddy.sh checks they still answer after a restart; may be empty).
EDGE_CADDYFILE=/opt/edge/Caddyfile
EDGE_CADDY_CONTAINER=edge-caddy-1
EDGE_OTHER_SITES=https://other-app.example.com/
